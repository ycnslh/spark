# Port d'écoute (utilisé via network_mode: host)
PORT=8085

# Niveau de log: debug | info | warn | error
LOG_LEVEL=info

# Cible WoL unique (vide : détection automatique des broadcasts IPv4 locaux)
WOL_BROADCAST=
# Ajouter les broadcasts de toutes les interfaces IPv4 non internes
# false : seul 255.255.255.255, sauf si WOL_BROADCAST est défini
WOL_ALL_INTERFACES=true
# Second envoi en arrière-plan après ce délai (ms), 0 pour le désactiver
WOL_REPEAT_DELAY_MS=2000
# Port UDP WoL (optionnel)
WOL_PORT=9

# Authentification Basic (laisser vide pour désactiver)
AUTH_USER=
AUTH_PASS=

# Limite de réveils par minute par IP
WAKE_RATE_LIMIT=10

# Limite d'échecs d'auth par minute par IP (anti brute-force)
AUTH_RATE_LIMIT=5

# Connexions simultanées au flux GET /api/events (entier positif)
# Reverse proxy : désactiver le buffering SSE (proxy_buffering off sous Nginx)
SSE_MAX_CLIENTS=20

# Confiance dans X-Forwarded-For (0=jamais, 1=un proxy, 'loopback', etc.)
# À activer uniquement si l'app tourne derrière un reverse proxy
TRUST_PROXY=0

# Chemin de la base SQLite (utilisé en dev seulement, en docker c'est /app/data/spark.db)
# DB_PATH=./data/spark.db
